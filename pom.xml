<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.inin.analytics</groupId>
    <!-- artifactId is "elasticsearch-analysis-phone" so the default build produces
         elasticsearch-analysis-phone-<version>.zip, matching the ES analysis-plugin convention. -->
    <artifactId>elasticsearch-analysis-phone</artifactId>
    <packaging>jar</packaging>
    <!-- Plugin version matches the target Elasticsearch version exactly. -->
    <version>9.4.2</version>
    <name>elasticsearch-analysis-phone</name>
    <description>Elasticsearch Plugin for Phone and SIP Analysis</description>
    <url>https://github.com/johnnyshields/elasticsearch-phone</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Elasticsearch 9.x runs on, and is built with, JDK 21. -->
        <maven.compiler.release>21</maven.compiler.release>

        <elasticsearch.version>9.4.2</elasticsearch.version>
        <lucene.version>10.4.0</lucene.version>
        <libphonenumber.version>9.0.33</libphonenumber.version>

        <junit.version>4.13.2</junit.version>

        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
        <maven-assembly-plugin.version>3.7.1</maven-assembly-plugin.version>
    </properties>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/johnnyshields/elasticsearch-phone.git</connection>
        <developerConnection>scm:git:https://github.com/johnnyshields/elasticsearch-phone.git</developerConnection>
        <url>https://github.com/johnnyshields/elasticsearch-phone</url>
    </scm>

    <dependencies>
        <!--
            Elasticsearch (and the Lucene libraries it bundles) are supplied by the running
            node, so they are "provided": on the compile/test classpath but NOT bundled into
            the plugin zip. The plugin's elasticsearch.version must match the node exactly.
        -->
        <dependency>
            <groupId>org.elasticsearch</groupId>
            <artifactId>elasticsearch</artifactId>
            <version>${elasticsearch.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-core</artifactId>
            <version>${lucene.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-analysis-common</artifactId>
            <version>${lucene.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- The only third-party runtime dependency; bundled into the plugin zip. -->
        <dependency>
            <groupId>com.googlecode.libphonenumber</groupId>
            <artifactId>libphonenumber</artifactId>
            <version>${libphonenumber.version}</version>
        </dependency>

        <!-- Testing: analyzers are unit-tested directly via Lucene's BaseTokenStreamTestCase
             (no Elasticsearch node required). lucene-test-framework pulls in lucene-core,
             lucene-analysis-common and the randomizedtesting runner transitively. -->
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-test-framework</artifactId>
            <version>${lucene.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- Filter plugin-descriptor.properties so ${project.version},
                 ${elasticsearch.version}, etc. are resolved at build time. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <!-- LuceneTestCase requires assertions to be enabled. -->
                    <argLine>-ea</argLine>
                </configuration>
            </plugin>

            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>${maven-assembly-plugin.version}</version>
                <configuration>
                    <appendAssemblyId>false</appendAssemblyId>
                    <outputDirectory>${project.build.directory}/releases/</outputDirectory>
                    <descriptors>
                        <descriptor>${basedir}/src/main/assemblies/plugin.xml</descriptor>
                    </descriptors>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
